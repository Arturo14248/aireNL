##### OpenAQ API #####
# Copy this file to .env and replace the placeholders. .env is never committed.
# The OpenAQ SDK and the AireNL client both read OPENAQ_API_KEY.
OPENAQ_API_KEY="your_api_key_here"

##### Docker Compose Environment Variables #####
AIRFLOW_UID=501
FERNET_KEY=your_fernet_key
AIRFLOW_PROJ_DIR=./orchestration
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change_me
